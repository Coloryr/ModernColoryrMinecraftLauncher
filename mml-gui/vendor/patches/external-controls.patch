+    // ==== M²L 本地修改：外部控件提供者 ====
+    //
+    // 让应用**用自己的窗口按钮**（保留既有外观与组件），同时仍然拿到 Win11 贴靠布局。
+    //
+    // 背景：贴靠热区靠的是原生 `WM_NCHITTEST → HTMAXBUTTON`，而那个矩形的来源是
+    // 插件自己那套按钮的 getBoundingClientRect()。于是想换外观就只能覆盖它的按钮样式 ——
+    // 而它的样式表是运行时注入 <head> 末尾的，覆盖不可靠（实测两套按钮并存）。
+    //
+    // 这里改为：应用可以注册一个"提供最大化按钮矩形"的回调。注册后插件不再要求
+    // 自己那套按钮存在（也不再因几何为 null 而中止激活），矩形由应用给出，
+    // 应用爱画什么按钮就画什么按钮。
+    //
+    // - `provider`: () => ({ x, y, width, height, titlebarHeight, controlBandWidth } | null)
+    //   坐标为**物理像素**（与插件内部口径一致，即 CSS 像素 × devicePixelRatio）。
+    //   返回 null 表示当前不该有热区（如全屏），插件会照常把热区撤掉。
+    // - 传 null 取消注册，回到插件自带的按钮实现。
+    externalControlProvider: null,
+    setExternalControlProvider(provider) {
+      if (provider !== null && typeof provider !== "function") {
+        throw new TypeError(
+          "tauri-plugin-decoration: external control provider must be a function or null",
+        );
+      }
+      window[GLOBAL_NAME].externalControlProvider = provider;
+      // 立即让平台适配器重测一次：ResizeObserver 只盯插件自己的节点，
+      // 应用注册提供者不会改变它们，不推一把新矩形要等下次窗口缩放才生效
+      for (const refresh of window[GLOBAL_NAME].externalGeometryRefreshers) {
+        try {
+          refresh();
+        } catch {
+          /* 单个刷新失败不影响注册本身 */
+        }
+      }
+    },
+
+    /** 平台适配器注册的"重测几何"回调（外部提供者变更时由上面调用） */
+    externalGeometryRefreshers: new Set(),
+    registerExternalGeometryRefresh(refresh) {
+      window[GLOBAL_NAME].externalGeometryRefreshers.add(refresh);
+      return () => window[GLOBAL_NAME].externalGeometryRefreshers.delete(refresh);
+    },
+
+    // ==== M²L 本地修改：热区鼠标事件转发给应用 ====
+    //
+    // 原生命中区盖在 webview 上并吃掉 WM_NCMOUSEMOVE，应用自己的最大化按钮
+    // 收不到 DOM mouseenter —— 悬停样式不会亮。应用注册以下回调即可自行表现。
+    // （见 src/js/controls.js 的 handle()）
+    externalControlHoverListener: null,
+    externalControlClickListener: null,
+    notifyExternalControlHover(hovered) {
+      try {
+        window[GLOBAL_NAME].externalControlHoverListener?.(Boolean(hovered));
+      } catch {
+        /* 应用侧异常不影响插件 */
+      }
+    },
+    notifyExternalControlClick() {
+      try {
+        window[GLOBAL_NAME].externalControlClickListener?.();
+      } catch {
+        /* 同上 */
+      }
+    },
     status() {
       return { ...lastStatus };
     },

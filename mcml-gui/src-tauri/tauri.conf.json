{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mcml-gui",
  "version": "0.1.0",
  "identifier": "com.coloryr.mcml",
  "build": {
    "beforeDevCommand": "cd ../mcml-vue && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../mcml-vue && npm run build",
    "frontendDist": "../mcml-vue/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCML 启动器",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
